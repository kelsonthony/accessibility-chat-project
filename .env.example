BACKEND_PORT=3001
FRONTEND_PORT=3000
JWT_SECRET=change-me
JWT_KEY_ID=accesschat-default
# Preferred production setup: provide inline PEM or Base64 PEM, no file reads at runtime.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_PRIVATE_KEY_BASE64=
# JWT_PUBLIC_KEY_BASE64=
DATABASE_URL=postgresql://accesschat_app:<strong-password>@127.0.0.1:15432/accesschatdb
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=15000
LLM_PROMPT_VERSION=v1-grounded-sources
